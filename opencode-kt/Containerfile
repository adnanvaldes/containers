FROM docker.io/archlinux:base

# 1. Update mirrors and install JDK, Gradle, build tools, and opencode
RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm \
    base-devel \
    git \
    curl \
    jdk-openjdk \
    gradle \
    fish \
    opencode && \
    # Clean the pacman cache layer to keep the image slim
    pacman -Scc --noconfirm

# Set JAVA_HOME environment variable
ENV JAVA_HOME=/usr/lib/jvm/default-runtime

# 2. Hardcode the Kotlin/Gradle system rules into the image filesystem
RUN mkdir -p /root/.agents/skills /root/.config/opencode/skills
RUN mkdir -p /etc/opencode

WORKDIR /workspace
