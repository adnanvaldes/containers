FROM docker.io/archlinux:base

RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm \
    base-devel \
    git \
    curl \
    uv \
    fish && \
    # Clean the pacman cache layer to keep the image slim
    pacman -Scc --noconfirm

RUN curl -fsSL https://opencode.ai/v2/install | bash
RUN curl -fsSL https://raw.githubusercontent.com/Fission-AI/OpenSpec/main/scripts/binary/install.sh | bash
ENV PATH="/root/.opencode/bin:/root/.local/bin:${PATH}"

RUN test -x /root/.opencode/bin/opencode && \
    /root/.opencode/bin/opencode --version

RUN mkdir -p /root/.agents/skills /root/.config/opencode/skills
RUN mkdir -p /etc/opencode

WORKDIR /workspace
