FROM docker.io/archlinux:base

# 1. Update the mirrors and install core utilities, build tools, uv, and opencode
RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm \
    base-devel \
    git \
    curl \
    uv \
    fish \
    opencode && \
    # Clean the pacman cache layer to keep the image slim
    pacman -Scc --noconfirm

# 2. Hardcode the Python/uv system rules into the image filesystem
RUN mkdir -p /root/.agents/skills /root/.config/opencode/skills
rUN mkdir -p /etc/opencode

WORKDIR /workspace
